
---

## 2. `.gitignore` (Project Root)

```gitignore
# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# ─────────────────────────────────────────────────────────────
# Testing / Coverage
# ─────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# ─────────────────────────────────────────────────────────────
# Jupyter
# ─────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ─────────────────────────────────────────────────────────────
# IDE / Editor
# ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# ─────────────────────────────────────────────────────────────
# OS
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─────────────────────────────────────────────────────────────
# Project-specific outputs (keep the folder, ignore contents)
# ─────────────────────────────────────────────────────────────
data/outputs/*
!data/outputs/.gitkeep

# Model weights (downloaded at setup)
models/*.pt
models/*.onnx
models/*.engine
models/*.tflite
!models/.gitkeep

# Large input videos (do NOT commit media)
data/videos/*
!data/videos/.gitkeep

# Runtime logs
logs/
*.log

# Docker
.dockerignore

# Environment variables
.env
.env.*

# ─────────────────────────────────────────────────────────────
# Whitepaper build artifacts
# ─────────────────────────────────────────────────────────────
docs/*.pdf
!docs/whitepaper.pdf
docs/_build/
docs/.doctrees/

# ─────────────────────────────────────────────────────────────
# Benchmarks / profiling
# ─────────────────────────────────────────────────────────────
*.prof
*.cprofile
.benchmarks/